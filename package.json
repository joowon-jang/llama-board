{
  "name": "llama-board",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:tuning": "node --experimental-strip-types scripts/test-tuning-validation.ts",
    "test:sse": "node --experimental-strip-types scripts/test-sse.ts",
    "test:chat-stream": "node --experimental-strip-types scripts/test-chat-stream.ts",
    "test": "npm run test:tuning && npm run test:sse && npm run test:chat-stream",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2",
    "tailwindcss": "^4",
    "@tailwindcss/vite": "^4"
  }
}
