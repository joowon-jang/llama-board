{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llama-board",
  "version": "0.1.1",
  "identifier": "com.joojoo.llama-board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "llama-board",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.local http://localhost:1420 http://127.0.0.1:* http://localhost:* https://api.github.com https://github.com https://*.githubusercontent.com; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["target/release/llama-board-cli.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
